# Voice Clone Service - environment template
# Copy to .env and fill in real values. NEVER commit .env.
# Only variable names and comments live here - no real secrets.

# HTTP server
PORT=8021
HOST=0.0.0.0

# Volcengine ICL credentials (fill in real values at deploy time)
VOLC_APP_ID=
VOLC_TOKEN=
VOLC_RESOURCE_ID=seed-icl-1.0
# Set to 1 to disable cloud calls (mock mode, no real requests)
VOLC_TTS_DISABLE=0

# Local ZipVoice fallback engine
# Set to 1 to disable local engine (returns mock beep audio)
LOCAL_TTS_DISABLE=0
LOCAL_MODEL_DIR=models/
LOCAL_TTS_THREADS=4
LOCAL_TTS_NUM_STEPS=4

# Persistence
DB_PATH=data/voiceclone.db

# Optional management-page token hook (not enforced yet)
ADMIN_TOKEN=
