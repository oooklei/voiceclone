{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-start-capture",
    "allow-stop-capture",
    "allow-sidecar-status",
    "allow-fetch-get",
    "allow-fetch-post",
    "allow-speak",
    "allow-api-upload",
    "allow-save-audio-file"
  ]
}
