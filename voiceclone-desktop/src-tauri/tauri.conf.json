{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceClone",
  "version": "0.1.0",
  "identifier": "com.voiceclone.desktop",
  "build": {
    "frontendDist": "../../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "声音助手工作台",
        "width": 1100,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../dist/sidecar": "resources/sidecar"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./nsis/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}